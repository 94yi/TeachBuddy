# Copy this file to .env or run python scripts/configure_web.py.
# Set a strong private access password and a random secret of at least 32 characters.
TEACHBUDDY_PASSWORD=
TEACHBUDDY_SECRET=
TEACHBUDDY_PORT=8765
TEACHBUDDY_SECURE_COOKIE=false
# Required only for compose.https.yaml; DNS must already point to your server.
TEACHBUDDY_DOMAIN=
# Optional: OpenAI-compatible endpoint, including /v1 if required by your provider.
# Leave blank to use offline templates, imports and exports without AI.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=90
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=